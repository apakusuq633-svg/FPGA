    <mxCell id="input" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;检查输入与候选方向&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;160256×9原始点；1至3候选&lt;br&gt;候选两两至少相隔25°&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
