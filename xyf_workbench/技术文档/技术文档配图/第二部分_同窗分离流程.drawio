    </mxCell>
    <mxCell id="prepare" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;预处理与实际协方差估计&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;抗混叠后4倍抽取；选取8个STFT观察&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
