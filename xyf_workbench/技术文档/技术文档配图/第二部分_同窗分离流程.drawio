    </mxCell>
    <mxCell id="single" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;单候选：频域DAS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;同源导向补相&lt;br&gt;归一化等权叠加&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="60" y="590" width="475" height="120" as="geometry" />
    </mxCell>
    <mxCell id="multi" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;多候选：目标保护分离&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;保护目标子空间，利用残差协方差&lt;br&gt;软约束求解，最多三次有界尝试&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="665" y="590" width="475" height="120" as="geometry" />
    </mxCell>
    <mxCell id="guard" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;逐频点保真检查&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;检查目标响应、干扰泄漏与权值范数&lt;br&gt;不安全频点在输出中置零&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="245" y="800" width="710" height="120" as="geometry" />
    </mxCell>
    <mxCell id="reconstruct" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;整窗重构与候选就绪检查&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;频域加权 → IFFT → WOLA → 裁剪预热&lt;br&gt;输出40000点音频及候选就绪标志&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="245" y="1000" width="710" height="120" as="geometry" />
    </mxCell>
    <mxCell id="note" value="候选就绪条件：能量保留≥85%，载频覆盖≥95%，连续缺口≤3频点；处理成功不等于可诊断。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
