# 生成两个给 ITCM 预装了程序的顶层，由 create_vivado_project.tcl 按 top_module 分派：
#   gen_synth_top  → rv32_synth_top   时序评估用，无引脚，保留 retire_* 输出
#   gen_board_top  → rv32_board_top   上板用，引脚见 constrs/rv32_board_top.xdc
# 也可以单独跑：vivado -mode batch -source scripts/gen_synth_top.tcl
#
# 为什么非要生成、不能手写：预装 ITCM 要把 hex 的**绝对路径**烘进 rtl 顶层，而相对路径在
# Vivado 里解析不可靠。顶层只能有一个模块叫这个名字，所以手写的那份必须让位给生成的。
#
# 为什么非要预装：ITCM_FILE 为空时 ITCM 内容未知，取指数据成了 don't care，
# 综合会把整条流水线删掉——实测同一份 RTL，不装程序 98 个触发器，装了 4330 个。

proc gen_synth_top {root out_dir} {
    # TB 里 u_dut.u_itcm.memory[N] = 32'hXXXX 那一批就是程序，其余填 NOP。
    # 用正则挑数字下标，TB 开头那个填 NOP 的循环（下标是变量 i）不会被匹配到。
    set words [lrepeat 4096 00000013]
    set fp [open [file join $root tb tb_rv32_soc.v] r]
    foreach line [split [read $fp] "\n"] {
        if {[regexp {u_dut\.u_itcm\.memory\[([0-9]+)\]\s*=\s*32'h([0-9a-fA-F_]+)} $line -> idx val]} {
            set words [lreplace $words $idx $idx [string map {_ ""} $val]]
        }
    }
    close $fp

    file mkdir $out_dir
    set hex [string map {\\ /} [file normalize [file join $out_dir itcm_program.hex]]]
    set fp [open $hex w]
    puts $fp [join $words "\n"]
    close $fp

    # 路径必须写成正斜杠：Verilog 字符串里的反斜杠是转义符。
    set top [file join $out_dir rv32_synth_top.v]
    set fp [open $top w]
    # 产物里的注释一律写 ASCII。Tcl 的 [encoding system] 在这些机器上是 cp936，
    # 源码里的中文会被按 GBK 解码：写出来是乱码，而且字节错位偶尔会吐出引号，
    # 直接把脚本解析搞崩（写这段时就踩到过 "extra characters after close-quote"）。
    puts $fp "// Generated by scripts/gen_synth_top.tcl -- do not edit."
    puts $fp "// Same ports as rv32_soc; the only difference is that ITCM is preloaded"
    puts $fp "// with the smoke-test program scraped out of tb/tb_rv32_soc.v."
    puts $fp "  input         clk_i,"
    puts $fp "  input         rst_n_i,"
    puts $fp "  input         test_en_i,"
    puts $fp "  output        retire_valid_o,"
    puts $fp "  output \[31:0\] retire_pc_o,"
    puts $fp "  output \[31:0\] retire_instr_o,"
    puts $fp "  output \[3:0\]  retire_fault_o,"
    # PDM 麦阵列 9 根（1 根时钟 + 8 根数据）。出顶层是必须的：pdm_clk_o 要真的
    # 扇出到麦上才有时序意义，接死的话这一整块会被当成死逻辑剪掉。
    puts $fp "  output        pdm_clk_o,"
    puts $fp "  input  \[5:0\]  pdm_din_i"
    puts $fp ");"
    puts $fp ""
    puts $fp "  rv32_soc #("
    puts $fp "    .ITCM_FILE (\"$hex\")"
    puts $fp "  ) u_soc ("
    puts $fp "    .clk_i          (clk_i),"
    puts $fp "    .rst_n_i        (rst_n_i),"
    puts $fp "    .test_en_i      (test_en_i),"
    puts $fp "    .halt_i         (1'b0),"
    puts $fp "    .retire_valid_o (retire_valid_o),"
    puts $fp "    .retire_pc_o    (retire_pc_o),"
    puts $fp "    .retire_instr_o (retire_instr_o),"
    puts $fp "    .retire_fault_o (retire_fault_o),"
    puts $fp "    .tohost_o       (),"
    puts $fp "    .tohost_we_o    (),"
    puts $fp "    .fromhost_i     (32'b0),"
    puts $fp "    .led_o          (),"
    puts $fp "    .ps_req_i       (1'b0),"
    puts $fp "    .ps_write_i     (1'b0),"
    puts $fp "    .ps_sel_i       (1'b0),"
    puts $fp "    .ps_addr_i      (32'b0),"
    puts $fp "    .ps_wdata_i     (32'b0),"
    puts $fp "    .ps_ready_o     (),"
    puts $fp "    .ps_rdata_o     (),"
    puts $fp "    .coef_we_i       (1'b0),"
    puts $fp "    .coef_re_i       (1'b0),"
    puts $fp "    .coef_src_i      (1'b0),"
    puts $fp "    .coef_ch_i       (1'b0),"
    puts $fp "    .coef_idx_i      (9'b0),"
    puts $fp "    .coef_wdata_i    (16'b0),"
    puts $fp "    .coef_rdata_o    (),"
    # PDM 采集窗口由 PS 的 AXI 寄存器驱动，裸 PL 顶层没有 PS：输入接死、输出空着
    # （和 coef_* 同一个处理）。但**麦引脚要真出去** —— 见上面的端口注释。
    puts $fp "    .pdm_cfg_wr_i    (1'b0),"
    puts $fp "    .pdm_cfg_rd_i    (1'b0),"
    puts $fp "    .pdm_cfg_addr_i  (7'b0),"
    puts $fp "    .pdm_cfg_wdata_i (32'b0),"
    puts $fp "    .pdm_cfg_rdata_o (),"
    # 定位加速器两窗同样由 AXI 寄存器驱动，裸 PL 顶层没有 PS ⇒ 输入接死、输出空着。
    # 与 pdm_cfg_* 不同的是：这两块**在裸 PL 里也留着**（不剪），因为门铃指令
    # 与它们都在核内，没有 PS 也跑得起来 —— 台面探针要量它们的时序。
    puts $fp "    .srp_cfg_wr_i    (1'b0),"
    puts $fp "    .srp_cfg_rd_i    (1'b0),"
    puts $fp "    .srp_cfg_addr_i  (7'b0),"
    puts $fp "    .srp_cfg_wdata_i (32'b0),"
    puts $fp "    .srp_cfg_rdata_o (),"
    puts $fp "    .xsp_cfg_wr_i    (1'b0),"
    puts $fp "    .xsp_cfg_rd_i    (1'b0),"
    puts $fp "    .xsp_cfg_addr_i  (7'b0),"
    puts $fp "    .xsp_cfg_wdata_i (32'b0),"
    puts $fp "    .xsp_cfg_rdata_o (),"
    puts $fp "    .steer_cfg_wr_i    (1'b0),"
    puts $fp "    .steer_cfg_rd_i    (1'b0),"
    puts $fp "    .steer_cfg_addr_i  (7'b0),"
    puts $fp "    .steer_cfg_wdata_i (32'b0),"
    puts $fp "    .steer_cfg_rdata_o ()"
    puts $fp "  );"
    puts $fp ""
    puts $fp "endmodule"
    close $fp

    puts "==> synth top generated: $top"
    puts "==> ITCM program exported: $hex"
    return $top
}

# 生成上板顶层：端口是板子上的 clk_i / rst_n_i / led_o[2:0]，ITCM 预装流水灯固件。
#
# 固件镜像取自 sw/led_demo.hex（提交进版本库，由 scripts/gen_led_demo.py 生成）。
# 这里不顺手重新生成它：生成器要 Python，而综合不该因此多一个依赖——和
# gen_tb_program.py 的输出"粘回 TB"是同一个思路：产物入库，构建只消费。
proc gen_board_top {root out_dir {hex_rel "sw/led_demo.hex"}} {
    set hex [string map {\\ /} [file normalize [file join $root $hex_rel]]]
    if {![file exists $hex]} {
        error "ITCM image not found: $hex; generate it first: python3 scripts/gen_led_demo.py --hex $hex_rel"
    }

    # 注释里的引脚值抄自正点原子官方的 NAVIGATOR_ZYNQ_IO.xdc，与 constrs 下那份必须一致。
    set top [file join $out_dir rv32_board_top.v]
    set fp [open $top w]
    puts $fp "// Generated by scripts/gen_synth_top.tcl -- do not edit."
    puts $fp "//"
    puts $fp "// Bare-PL top for the Zhengdian Atom \"Navigator\" ZYNQ7010 board."
    puts $fp "// The core boots from firmware preloaded into ITCM; no PS involved."
    puts $fp "//   clk_i   U18          board 50MHz oscillator (create_clock -period 20.000)"
    puts $fp "//   rst_n_i N16          dedicated system reset, active low, used as-is"
    puts $fp "//   led_o   H15/L15/J16  the board has only these 3 PL LEDs, active high"
    puts $fp "//"
    puts $fp "// Preloading ITCM is mandatory, not optional: with an empty ITCM the fetched"
    puts $fp "// data is unknown, so synthesis treats the whole core as don't-care and prunes"
    puts $fp "// it (98 FFs vs 4330 FFs on the same RTL). On the board that looks like"
    puts $fp "// \"nothing happens\", easy to misdiagnose as a broken bitstream."
    puts $fp "//"
    puts $fp "// Leaving retire_* unconnected is safe here: led_o pins the core down (the LED"
    puts $fp "// can only change if the whole fetch/decode/memory/store chain exists), so the"
    puts $fp "// dangling outputs only prune the retire observation logic."
    puts $fp "module rv32_board_top ("
    puts $fp "  input  clk_i,"
    puts $fp "  input  rst_n_i,"
    puts $fp "  output \[2:0\] led_o"
    puts $fp ");"
    puts $fp ""
    puts $fp "  rv32_soc #("
    puts $fp "    .ITCM_FILE (\"$hex\"),"
    puts $fp "    .LED_WIDTH (3)"
    puts $fp "  ) u_soc ("
    puts $fp "    .clk_i          (clk_i),"
    puts $fp "    .rst_n_i        (rst_n_i),"
    puts $fp "    .test_en_i      (1'b0),"
    puts $fp "    .halt_i         (1'b0),"
    puts $fp "    .retire_valid_o (),"
    puts $fp "    .retire_pc_o    (),"
    puts $fp "    .retire_instr_o (),"
    puts $fp "    .retire_fault_o (),"
    puts $fp "    .tohost_o       (),"
    puts $fp "    .tohost_we_o    (),"
    puts $fp "    .fromhost_i     (32'b0),"
    puts $fp "    .led_o          (led_o),"
    puts $fp "    .ps_req_i       (1'b0),"
    puts $fp "    .ps_write_i     (1'b0),"
    puts $fp "    .ps_sel_i       (1'b0),"
    puts $fp "    .ps_addr_i      (32'b0),"
    puts $fp "    .ps_wdata_i     (32'b0),"
    puts $fp "    .ps_ready_o     (),"
    puts $fp "    .ps_rdata_o     (),"
    puts $fp "    .coef_re_i       (1'b0),"
    puts $fp "    .coef_src_i      (1'b0),"
    puts $fp "    .coef_ch_i       (1'b0),"
    puts $fp "    .coef_idx_i      (9'b0),"
    puts $fp "    .coef_wdata_i    (16'b0),"
    puts $fp "    .coef_rdata_o    (),"
    # 输入仍逐个显式接死 —— 具名例化漏接是 z，进模块变 x。
    puts $fp "    .pdm_clk_o       (),"
    puts $fp "    .pdm_din_i       (6'b0),"
    puts $fp "    .pdm_cfg_wr_i    (1'b0),"
    puts $fp "    .pdm_cfg_rd_i    (1'b0),"
    puts $fp "    .pdm_cfg_addr_i  (7'b0),"
    puts $fp "    .pdm_cfg_wdata_i (32'b0),"
    puts $fp "    .pdm_cfg_rdata_o (),"
    # 定位加速器两窗：同 pdm_cfg_*，裸 PL 顶层没有 PS，输入接死、输出空着。
    puts $fp "    .srp_cfg_wr_i    (1'b0),"
    puts $fp "    .srp_cfg_rd_i    (1'b0),"
    puts $fp "    .srp_cfg_addr_i  (7'b0),"
    puts $fp "    .srp_cfg_wdata_i (32'b0),"
    puts $fp "    .srp_cfg_rdata_o (),"
    puts $fp "    .xsp_cfg_wr_i    (1'b0),"
    puts $fp "    .xsp_cfg_rd_i    (1'b0),"
    puts $fp "    .xsp_cfg_addr_i  (7'b0),"
    puts $fp "    .xsp_cfg_wdata_i (32'b0),"
    puts $fp "    .xsp_cfg_rdata_o (),"
    puts $fp "    .steer_cfg_wr_i    (1'b0),"
    puts $fp "    .steer_cfg_rd_i    (1'b0),"
    puts $fp "    .steer_cfg_addr_i  (7'b0),"
    puts $fp "    .steer_cfg_wdata_i (32'b0),"
    puts $fp "    .steer_cfg_rdata_o ()"
    puts $fp "  );"
    puts $fp ""
    puts $fp "endmodule"
    close $fp

    puts "==> board top generated: $top"
    puts "==> ITCM image: $hex"
    return $top
}
