    <mxCell id="core" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;五级RISC-V与固件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;IF → ID → EX → MEM → WB&lt;br&gt;寄存器、前递、ALU及乘除法&lt;br&gt;按定位请求选择计算阶段&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="55" y="235" width="360" height="145" as="geometry" />
    </mxCell>
    <mxCell id="dispatch" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;自定义指令发射&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;VFFT：正 / 逆变换&lt;br&gt;VSUB：共轭互谱；VPHAT&lt;br&gt;VLOC：启动核外SRP&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="55" y="485" width="360" height="145" as="geometry" />
    </mxCell>
    <mxCell id="retire" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;指令完成与退休交接&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;运算完成、流水线接纳结果&lt;br&gt;FFT / 互谱 / PHAT指令退休&lt;br&gt;才通知RTL进入下一搬运阶段&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="55" y="795" width="360" height="145" as="geometry" />
    </mxCell>
    <mxCell id="raw" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;原始PCM环形缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;九路PCM按样本序号写入&lt;br&gt;1024点窗口，512点步长&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="525" y="235" width="300" height="125" as="geometry" />
    </mxCell>
    <mxCell id="prepare" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;滚动统计与输入准备&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;采集时累积统计；窗就绪后去均值、缩放、加窗&lt;br&gt;两实数打包为一复数，装入FFT&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="900" y="235" width="635" height="125" as="geometry" />
    </mxCell>
    <mxCell id="fft" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;核内共享FFT / IFFT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;1024点实数 ↔ 512点复数&lt;br&gt;此处先执行九路正变换&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="525" y="500" width="300" height="140" as="geometry" />
    </mxCell>
    <mxCell id="spectra" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;九路频谱缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;每通道缓存64个频点&lt;br&gt;36麦对复用九路频谱&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="880" y="500" width="300" height="140" as="geometry" />
    </mxCell>
    <mxCell id="ac" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;核内四路复数单元&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;读入当前麦对的两路频谱&lt;br&gt;共轭互谱 → PHAT归一化&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="1235" y="500" width="300" height="140" as="geometry" />
    </mxCell>
    <mxCell id="phi" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;归一化互谱缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;保存当前麦对结果&lt;br&gt;补零后装入同一FFT核&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="1235" y="805" width="300" height="125" as="geometry" />
    </mxCell>
    <mxCell id="inverse" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;逆变换复用FFT核&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;不新增第二个FFT实例&lt;br&gt;只取定位需要的相关区间&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="880" y="805" width="300" height="125" as="geometry" />
    </mxCell>
    <mxCell id="correlation" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;36麦对相关环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;每麦对保留64个相关值&lt;br&gt;按麦对写入SRP相关分区&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="525" y="805" width="300" height="125" as="geometry" />
    </mxCell>
    <mxCell id="srp" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;核外四麦对并行SRP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;相关分区 + 方向时差表&lt;br&gt;四麦对插值、求和后累加&lt;br&gt;36麦对 → 1024方向评分&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="525" y="1125" width="300" height="155" as="geometry" />
    </mxCell>
    <mxCell id="score" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;方向评分与统计读口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;片上评分存储、质量统计&lt;br&gt;供软核遍历及结果复核&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="880" y="1125" width="300" height="155" as="geometry" />
    </mxCell>
    <mxCell id="publish" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;固件发布完整方向图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;检查幅度、峰值与截止期&lt;br&gt;写入结果区并切换版本&lt;br&gt;PS读取方向图和状态&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="1235" y="1125" width="300" height="155" as="geometry" />
    </mxCell>
    <mxCell id="transfer" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;RTL搬运状态机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;提交当前阶段请求&lt;br&gt;推进地址、装载 / 取回 / 转存&lt;br&gt;管理右侧缓存与核内搬运端口&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="55" y="1080" width="360" height="155" as="geometry" />
    </mxCell>
    <mxCell id="das" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;九路DAS输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;按方向补偿后叠加的逐样音频&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
