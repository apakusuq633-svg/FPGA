=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="psc1" target="psalgo"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="psmem" target="pstask"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;" edge="1" parent="1" source="psalgo" target="pstask"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="psalgo" target="pswork"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="psc0" target="psgsc"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="260" /><mxPoint x="800" y="485" /><mxPoint x="610" y="485" /></Array></mxGeometry></mxCell><mxCell id="edge11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ba6a18;strokeWidth=2;endArrow=block;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;dashed=1;" edge="1" parent="1" source="psctl" target="psin"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="psin" value="PS 硬件接口&lt;br&gt;HP0 数据入口／GP0 控制出口" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="160" width="320" height="100" /></mxCell><mxCell id="psc0" value="Cortex-A9 CPU0&lt;br&gt;接收校验、历史与轨迹维护" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="160" width="320" height="100" /></mxCell><mxCell id="psmem" value="DDR 共享历史与任务区&lt;br&gt;历史 32 MiB／任务 1 MiB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="160" width="320" height="100" /></mxCell><mxCell id="psc1" value="Cortex-A9 CPU1&lt;br&gt;搜索、同窗分离与故障分析" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="160" width="320" height="100" /></mxCell><mxCell id="psctl" value="PL 控制与方向提交&lt;br&gt;九路延迟写入、提交及读回" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="335" width="320" height="100" /></mxCell><mxCell id="psreview" value="CPU0 诊断复核与目标选择&lt;br&gt;检查唯一故障、时效与有效性" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="335" width="320" height="100" /></mxCell><mxCell id="pstask" value="固定快照与任务／结果交接&lt;br&gt;采样区间、轨迹、采集代次绑定" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="335" width="320" height="100" /></mxCell><mxCell id="psalgo" value="CPU1 软件处理链&lt;br&gt;多频带搜索 → 同窗分离&lt;br&gt;包络与 18 维阶次 → 模型拒识" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="335" width="320" height="100" /></mxCell><mxCell id="psweb" value="以太网控制器与网络服务&lt;br&gt;浏览器双层界面、事件与录音" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="510" width="320" height="100" /></mxCell><mxCell id="psgsc" value="CPU0 固定目标 GSC 试听&lt;br&gt;手动方向／DAS 与 GSC 成对音频" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="510" width="320" height="100" /></mxCell><mxCell id="pscache" value="双核共享内存一致性&lt;br&gt;SCU／各核缓存、MMU 与屏障" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="510" width="320" height="100" /></mxCell><mxCell id="pswork" value="CPU1 独占 DDR 工作区&lt;br&gt;频谱、协方差与整窗音频" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="510" width="320" height="100" /></mxCell><mxCell id="text0" value="PS 整体硬件与软件任务框图" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="22" width="1500" height="45" /></mxCell><mxCell id="text1" value="③ PS 整体框图｜双核 Cortex-A9、DDR 共享数据与网络接口" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="105" width="1500" height="40" /></mxCell><mxCell id="text2" value="正式定向：诊断复核通过后提交 PL。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="455" width="1500" height="32" /></mxCell><mxCell id="text3" value="手动 GSC 方向由网页独立设置。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="455" width="730" height="32" /></mxCell><mxCell id="text4" value="说明：CPU0／CPU1 框内为运行于 PS 的软件职责；DDR、SCU、缓存及接口为硬件资源。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="655" width="1500" height="33" /></mxCell></root></mxGraphModel>