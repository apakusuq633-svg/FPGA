    <mxCell id="align" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;音频抽取与目标补偿&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;九路127抽头低通 / 8；按手动方向补偿&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
