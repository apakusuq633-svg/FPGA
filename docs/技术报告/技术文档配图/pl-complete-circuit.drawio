r=#426581;strokeWidth=2;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="plfir" target="plpack"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="plpre" target="plwin"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="995" y="300" /><mxPoint x="225" y="300" /></Array></mxGeometry></mxCell><mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="plpre" target="pldas"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="995" y="300" /><mxPoint x="45" y="300" /><mxPoint x="45" y="465" /><mxPoint x="225" y="465" /></Array></mxGeometry></mxCell><mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#426581;strokeWidth=2;endArrow=block;exitX=1.0;exitY=0.5;entryX=1.0;entryY=0.5;" edge="1" parent="1" source="plpre" target="plpack"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1185" y="205" /><mxPoint x="1185" y="535" /></Array></mxGeometry></mxCell><mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ba6a18;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=1.0;dashed=1;" edge="1" parent="1" source="plsteer" target="pldas"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1380" y="605" /><mxPoint x="225" y="605" /></Array></mxGeometry></mxCell><mxCell id="plin" value="九麦阵列接口&lt;br&gt;5 根 DATA／公共 PDM_CLK" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="160" width="320" height="90" /></mxCell><mxCell id="plrx" value="PDM 接收与抽取&lt;br&gt;双相采样 → CIC → 九路 PCM" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="160" width="320" height="90" /></mxCell><mxCell id="plpre" value="通道预处理与同步分流&lt;br&gt;去直流、增益校正｜156250 Hz" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="160" width="320" height="90" /></mxCell><mxCell id="pltime" value="时钟、复位与测速&lt;br&gt;PL 40 MHz／测速同步滤波" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="160" width="320" height="90" /></mxCell><mxCell id="plwin" value="重叠窗口与搬运状态机&lt;br&gt;1024 点窗／512 点步长" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="325" width="320" height="90" /></mxCell><mxCell id="plcore" value="自研五级 RISC-V 声学处理器&lt;br&gt;共享 FFT/IFFT、四路复数单元" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="325" width="320" height="90" /></mxCell><mxCell id="plsrp" value="相关环存储与四麦对 SRP&lt;br&gt;36 麦对 → 1024 格方向评分" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="325" width="320" height="90" /></mxCell><mxCell id="plreg" value="控制与状态寄存器&lt;br&gt;定位结果、采集代次、测速状态" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="325" width="320" height="90" /></mxCell><mxCell id="pldas" value="连续 DAS 定向拾音&lt;br&gt;九路延迟补偿与求和" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="490" width="320" height="90" /></mxCell><mxCell id="plfir" value="连续 FIR 与共享 SIMD&lt;br&gt;32 抽头／八路实数乘加" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="490" width="320" height="90" /></mxCell><mxCell id="plpack" value="采样打包与非阻塞 DMA&lt;br&gt;九路原始 PCM＋DAS/FIR＋状态" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="490" width="320" height="90" /></mxCell><mxCell id="plsteer" value="九路延迟原子提交&lt;br&gt;影子向量 → 同版生效与平滑" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="490" width="320" height="90" /></mxCell><mxCell id="text0" value="PL 整体电路框图" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="22" width="1500" height="45" /></mxCell><mxCell id="text1" value="① PL 整体电路框图｜同步采集、声学定位与连续拾音" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="105" width="1500" height="40" /></mxCell><mxCell id="text2" value="公共时钟由 PDM 时钟发生器送往阵列；预处理后的九路 PCM 同时供窗口、DAS 与采样打包。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="265" width="1500" height="32" /></mxCell><mxCell id="text3" value="软核发射声学指令；搬运状态机等待指令退休，再组织频谱、互谱、PHAT、IFFT 和 SRP 数据。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="430" width="1115" height="32" /></mxCell><mxCell id="text4" value="PL → PS：DMA 样本流＋寄存器定位结果；PS → PL：参数、恢复和九路延迟提交。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="640" width="1500" height="33" /></mxCell></root></mxGraphModel>