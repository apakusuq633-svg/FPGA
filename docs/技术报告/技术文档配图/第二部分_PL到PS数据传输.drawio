        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="pack" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;采样打包&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;九路PCM、PL DAS / FIR&lt;br&gt;同一采样编号的版本与状态&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="65" y="275" width="300" height="150" as="geometry" />
    </mxCell>
    <mxCell id="queue" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;内部缓冲队列&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;暂存传输副本&lt;br&gt;吸收短时总线等待&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="435" y="275" width="300" height="150" as="geometry" />
    </mxCell>
    <mxCell id="dma" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;非阻塞DMA写入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;经64位AXI → PS HP0&lt;br&gt;每槽128字节，16拍突发&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="805" y="275" width="300" height="150" as="geometry" />
    </mxCell>
    <mxCell id="ddr" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;DDR环形槽&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;写响应成功且事务无故障&lt;br&gt;才发布新的完成位置&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#f3f6f9;strokeColor=#9babbc;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="805" y="650" width="300" height="150" as="geometry" />
    </mxCell>
    <mxCell id="check" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;CPU0读取与校验&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;先使缓存失效，再读槽&lt;br&gt;检查所有权、序号与CRC&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="435" y="650" width="300" height="150" as="geometry" />
    </mxCell>
    <mxCell id="history" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;写入九路历史缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;按原始采样编号保存&lt;br&gt;供CPU1搜索与同窗诊断&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="65" y="650" width="300" height="150" as="geometry" />
    </mxCell>
    <mxCell id="publish_label" value="完成后可读" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#62788c;strokeColor=none;fillColor=#ffffff;" vertex="1" parent="1">
      <mxGeometry x="950" y="515" width="155" height="32" as="geometry" />
    </mxCell>
    <mxCell id="ack_label" value="消费确认：CPU0经AXI4-Lite更新消费位置，DMA才可复用已释放槽" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#bb772d;strokeColor=none;fillColor=#ffffff;" vertex="1" parent="1">
      <mxGeometry x="180" y="875" width="830" height="35" as="geometry" />
    </mxCell>
    <mxCell id="failure" value="队列或DDR环满时可丢弃传输副本并计数；总线故障单独记录，PL采集与DAS继续运行。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="50" y="945" width="1100" height="35" as="geometry" />
    </mxCell>
    <mxCell id="note" value="说明：图中传输的是原始采样记录，不是G9A1试听包；GSC抽取和网络发送在PS侧另行处理。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="50" y="995" width="1100" height="40" as="geometry" />
    </mxCell>
  </root>
