xCell><mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ba6a18;strokeWidth=2;endArrow=block;exitX=0.5;exitY=0.0;entryX=0.203125;entryY=1.0;dashed=1;" edge="1" parent="1" source="txcpu" target="txdma"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="610" y="315" /><mxPoint x="900" y="315" /></Array></mxGeometry></mxCell><mxCell id="txp" value="采样打包&lt;br&gt;九路 PCM＋DAS/FIR＋采样身份" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="165" width="320" height="100" /></mxCell><mxCell id="txq" value="内部同步 FIFO&lt;br&gt;缓冲记录；拥塞时记录丢失" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="165" width="320" height="100" /></mxCell><mxCell id="txdma" value="自研非阻塞 DMA&lt;br&gt;128 字节槽／16 拍 × 64 位" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="165" width="320" height="100" /></mxCell><mxCell id="txhp" value="AXI 互连 → PS HP0&lt;br&gt;64 位写入 PS DDR" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="165" width="320" height="100" /></mxCell><mxCell id="txhist" value="九路历史缓存&lt;br&gt;0x0A000000／预留 32 MiB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="350" width="320" height="100" /></mxCell><mxCell id="txcpu" value="CPU0 读取与校验&lt;br&gt;缓存失效、屏障、序号与 CRC" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="350" width="320" height="100" /></mxCell><mxCell id="txring" value="DDR 所有权环&lt;br&gt;0x08000000／实际环槽 512 KiB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="350" width="320" height="100" /></mxCell><mxCell id="txcfg" value="PS GP0 → AXI4-Lite&lt;br&gt;主控 0x43C00000&lt;br&gt;DMA 0x43C10000" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="350" width="320" height="100" /></mxCell><mxCell id="text0" value="PL 向 PS 数据传输框图" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="22" width="1500" height="45" /></mxCell><mxCell id="text1" value="② PL → PS 传输框图｜数据写入、所有权交接与控制返回" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="105" width="1500" height="40" /></mxCell><mxCell id="text2" value="消费完成后释放环槽" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="285" width="925" height="31" /></mxCell><mxCell id="text3" value="写入成功且 AXI 写响应无故障后，DMA 才发布生产位置；CPU0 仅消费已发布槽，再更新消费位置。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="485" width="1500" height="34" /></mxCell><mxCell id="text4" value="GP0 控制参数与所有权；HP0 承载采样记录。下游拥塞不暂停 PL 采集，缺口通过计数与采样序号报告。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="525" width="1500" height="33" /></mxCell><mxCell id="text5" value="实线：数据／处理结果；橙色虚线：控制／反馈。寄存器窗口各 4 KiB；DMA 区预留 1 MiB。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="610" width="1500" height="33" /></mxCell></root></mxGraphModel>