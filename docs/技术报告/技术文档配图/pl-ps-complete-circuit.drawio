ntSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="845" width="320" height="100" /></mxCell><mxCell id="txhist" value="九路历史缓存&lt;br&gt;0x0A000000／预留 32 MiB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1030" width="320" height="100" /></mxCell><mxCell id="txcpu" value="CPU0 读取与校验&lt;br&gt;缓存失效、屏障、序号与 CRC" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="1030" width="320" height="100" /></mxCell><mxCell id="txring" value="DDR 所有权环&lt;br&gt;0x08000000／实际环槽 512 KiB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="1030" width="320" height="100" /></mxCell><mxCell id="txcfg" value="PS GP0 → AXI4-Lite&lt;br&gt;主控 0x43C00000&lt;br&gt;DMA 0x43C10000" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1030" width="320" height="100" /></mxCell><mxCell id="psin" value="PS 硬件接口&lt;br&gt;HP0 数据入口／GP0 控制出口" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1510" width="320" height="100" /></mxCell><mxCell id="psc0" value="Cortex-A9 CPU0&lt;br&gt;接收校验、历史与轨迹维护" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="1510" width="320" height="100" /></mxCell><mxCell id="psmem" value="DDR 共享历史与任务区&lt;br&gt;历史 32 MiB／任务 1 MiB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="1510" width="320" height="100" /></mxCell><mxCell id="psc1" value="Cortex-A9 CPU1&lt;br&gt;搜索、同窗分离与故障分析" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf2fb;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1510" width="320" height="100" /></mxCell><mxCell id="psctl" value="PL 控制与方向提交&lt;br&gt;九路延迟写入、提交及读回" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1685" width="320" height="100" /></mxCell><mxCell id="psreview" value="CPU0 诊断复核与目标选择&lt;br&gt;检查唯一故障、时效与有效性" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff1df;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="1685" width="320" height="100" /></mxCell><mxCell id="pstask" value="固定快照与任务／结果交接&lt;br&gt;采样区间、轨迹、采集代次绑定" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="1685" width="320" height="100" /></mxCell><mxCell id="psalgo" value="CPU1 软件处理链&lt;br&gt;多频带搜索 → 同窗分离&lt;br&gt;包络与 18 维阶次 → 模型拒识" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1685" width="320" height="100" /></mxCell><mxCell id="psweb" value="以太网控制器与网络服务&lt;br&gt;浏览器双层界面、事件与录音" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1860" width="320" height="100" /></mxCell><mxCell id="psgsc" value="CPU0 固定目标 GSC 试听&lt;br&gt;手动方向／DAS 与 GSC 成对音频" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e9f5ee;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="1860" width="320" height="100" /></mxCell><mxCell id="pscache" value="双核共享内存一致性&lt;br&gt;SCU／各核缓存、MMU 与屏障" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="1860" width="320" height="100" /></mxCell><mxCell id="pswork" value="CPU1 独占 DDR 工作区&lt;br&gt;频谱、协方差与整窗音频" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#f0eafa;strokeColor=#7591aa;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1860" width="320" height="100" /></mxCell><mxCell id="text0" value="九麦声学定位引导故障诊断系统｜PL—传输—PS 完整电路框图" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="22" width="1500" height="45" /></mxCell><mxCell id="text1" value="① PL 整体电路框图｜同步采集、声学定位与连续拾音" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="105" width="1500" height="40" /></mxCell><mxCell id="text2" value="公共时钟由 PDM 时钟发生器送往阵列；预处理后的九路 PCM 同时供窗口、DAS 与采样打包。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="265" width="1500" height="32" /></mxCell><mxCell id="text3" value="软核发射声学指令；搬运状态机等待指令退休，再组织频谱、互谱、PHAT、IFFT 和 SRP 数据。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="430" width="1115" height="32" /></mxCell><mxCell id="text4" value="PL → PS：DMA 样本流＋寄存器定位结果；PS → PL：参数、恢复和九路延迟提交。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="640" width="1500" height="33" /></mxCell><mxCell id="text5" value="② PL → PS 传输框图｜数据写入、所有权交接与控制返回" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="785" width="1500" height="40" /></mxCell><mxCell id="text6" value="消费完成后释放环槽" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="965" width="925" height="31" /></mxCell><mxCell id="text7" value="写入成功且 AXI 写响应无故障后，DMA 才发布生产位置；CPU0 仅消费已发布槽，再更新消费位置。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1165" width="1500" height="34" /></mxCell><mxCell id="text8" value="GP0 控制参数与所有权；HP0 承载采样记录。下游拥塞不暂停 PL 采集，缺口通过计数与采样序号报告。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1205" width="1500" height="33" /></mxCell><mxCell id="text9" value="实线：数据／处理结果；橙色虚线：控制／反馈。寄存器窗口各 4 KiB；DMA 区预留 1 MiB。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1290" width="1500" height="33" /></mxCell><mxCell id="text10" value="③ PS 整体框图｜双核 Cortex-A9、DDR 共享数据与网络接口" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1455" width="1500" height="40" /></mxCell><mxCell id="text11" value="正式定向：诊断复核通过后提交 PL。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1805" width="1500" height="32" /></mxCell><mxCell id="text12" value="手动 GSC 方向由网页独立设置。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="1805" width="730" height="32" /></mxCell><mxCell id="text13" value="说明：CPU0／CPU1 框内为运行于 PS 的软件职责；DDR、SCU、缓存及接口为硬件资源。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="2005" width="1500" height="33" /></mxCell></root></mxGraphModel>