    <mxCell id="title" value="故障特征分析与拾音方向控制" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#20384e;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="50" y="24" width="1100" height="48" as="geometry" />
    </mxCell>
    <mxCell id="subtitle" value="先确认声音与方向属于同一快照，再判断故障；条件不足时保留未知及原因。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="50" y="78" width="1100" height="38" as="geometry" />
    </mxCell>
