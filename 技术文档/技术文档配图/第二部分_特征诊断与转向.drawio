    <mxCell id="review_unknown" edge="1" source="review" target="unknown" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;arcSize=12;strokeWidth=1.8;strokeColor=#bb772d;endArrow=block;endSize=7;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8055555555555556;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=5 4;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="audio" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;检查分离音频及绑定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;40000点，39062.5 Hz；核对快照与方向身份&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="70" y="170" width="740" height="105" as="geometry" />
    </mxCell>
    <mxCell id="env" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;提取长窗包络&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;2200—4600 Hz解析带通；两级抽取&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="70" y="335" width="740" height="105" as="geometry" />
    </mxCell>
    <mxCell id="features" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;提取18维阶次特征&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;2500点包络，补零4096点FFT；结合轴频&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="70" y="500" width="740" height="105" as="geometry" />
    </mxCell>
    <mxCell id="model" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;模型检查与未知拒识&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;核对特征与分离版本、转速及有效频带&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="70" y="665" width="740" height="105" as="geometry" />
    </mxCell>
    <mxCell id="review" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;复核并选择故障目标&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;CPU0：结果新鲜且仅有一个可信故障目标&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="70" y="830" width="740" height="105" as="geometry" />
    </mxCell>
    <mxCell id="commit" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;提交九路延迟并读回&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;PL原子接纳；DAS应用；GSC按版本匹配&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff5e7;strokeColor=#cda56e;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="70" y="995" width="740" height="105" as="geometry" />
    </mxCell>
    <mxCell id="unknown" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;未知或撤销定向&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;条件不足或无唯一目标&lt;br&gt;保留原因与显示&lt;br&gt;重新积累有效证据&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff2ec;strokeColor=#cd9a7f;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="900" y="665" width="260" height="270" as="geometry" />
    </mxCell>
    <mxCell id="note" value="颜色分工：绿色为CPU1特征与判别，浅橙为CPU0复核与控制；橙色虚线表示撤销控制。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="50" y="1125" width="1100" height="40" as="geometry" />
    </mxCell>
  </root>
