    <mxCell id="claim" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;认领任务并占用结果槽&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;先按优先条件服务辅助搜索&lt;br&gt;无待执行任务或无空槽时返回主循环&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="110" y="170" width="650" height="130" as="geometry" />
    </mxCell>
    <mxCell id="copy" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;复制固定时段快照&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;固定采样终点；核对会话与采集时代&lt;br&gt;检查排队年龄和历史完整性&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="110" y="385" width="650" height="130" as="geometry" />
    </mxCell>
    <mxCell id="valid" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;输入与方向支持有效？&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="195" y="580" width="480" height="160" as="geometry" />
    </mxCell>
    <mxCell id="calc" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;同窗分离与逐候选诊断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;分离保真检查通过后，才进行故障诊断&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="110" y="810" width="650" height="110" as="geometry" />
    </mxCell>
    <mxCell id="publish" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;完成时复核并发布报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;复查采集时代、结果年龄与总耗时&lt;br&gt;超期撤销输出；发布报告并释放任务&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#ebf6f0;strokeColor=#7baa95;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="110" y="1010" width="650" height="120" as="geometry" />
    </mxCell>
    <mxCell id="reject" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;输入拒绝报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;本次不提供有效输出&lt;br&gt;保存拒绝原因&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#fff2ec;strokeColor=#cd9a7f;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="870" y="600" width="265" height="120" as="geometry" />
