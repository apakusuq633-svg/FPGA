    <mxCell id="yes_label" value="是" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="450" y="752" width="50" height="32" as="geometry" />
    </mxCell>
    <mxCell id="no_label" value="否" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#62788c;strokeColor=none;fillColor=none;" vertex="1" parent="1">
