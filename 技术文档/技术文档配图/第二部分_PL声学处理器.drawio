    <mxCell id="pcm" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;九路同步PCM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;来自同步采集与通道预处理&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="380" y="165" width="440" height="100" as="geometry" />
    </mxCell>
    <mxCell id="window" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;重叠窗口与滚动统计&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;1024点窗 / 512点步长&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
