    <mxCell id="srp" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;并行扫描声源方向&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;36麦对，四麦对一组&lt;br&gt;输出1024格方向评分&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
