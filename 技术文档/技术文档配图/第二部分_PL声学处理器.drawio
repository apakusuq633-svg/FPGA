    <mxCell id="fir" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;32抽头FIR滤波&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;共享八路并行乘加单元&lt;br&gt;与CPU请求仲裁使用&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
