    <mxCell id="das" value="&lt;b style=&quot;font-size:26.0px&quot;&gt;九路延时补偿与叠加&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px&quot;&gt;DAS按方向补偿，归一化输出&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#20384e;fontSize=22;spacing=10;fillColor=#edf4fc;strokeColor=#87a7ca;strokeWidth=1.5;" vertex="1" parent="1">
